# Copy to .env in the working directory, or select a private file with --env-file.
PDF2MEM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alibaba Cloud Model Studio: copy the compatible base URL for the key's workspace.
# For Singapore: https://YOUR-WORKSPACE-ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Another chat/completions service with JSON object output (e.g. a local server).
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
